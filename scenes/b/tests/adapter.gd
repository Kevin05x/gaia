extends SceneTree
class FakeBus extends Node:
 signal snapshot_changed(value: Dictionary)
 signal cmd_move_rover(tile: Vector2i)
 signal cmd_act(target: String,action: String)
 signal cmd_transmit(on: bool)
 signal cmd_upgrade_antenna()
 signal sol_advanced(sol: int,hour: float)
 signal battery_changed(wh: float,cap: float,gen: float,load_w: float)
 signal command_rejected(key: String)
func _initialize() -> void:run.call_deferred()
func run() -> void:
 var port=load("res://scenes/b/port.gd").new();root.add_child(port)
 var bus=FakeBus.new();root.add_child(bus)
 var adapter=load("res://scenes/b/event_bus_adapter.gd").new();root.add_child(adapter)
 var requests=[];bus.cmd_move_rover.connect(func(tile: Vector2i):requests.append(tile))
 adapter.bind(port,bus,{"phase":"operations","sol":1,"hour":8})
 port.submit("move",{"tile":Vector2i(2,3)})
 assert(requests==[Vector2i(2,3)])
 bus.battery_changed.emit(800,1000,110,20)
 assert(port.snapshot.battery.wh==800)
 bus.sol_advanced.emit(2,12.5)
 assert(port.snapshot.sol==2 and port.snapshot.hour==12.5)
 bus.snapshot_changed.emit({"phase":"operations","mineral":5})
 assert(port.snapshot.mineral==5)
 var reasons=[];port.rejected.connect(func(key: String):reasons.append(key))
 port.submit("pause",{"paused":true})
 assert(reasons==["WAIT"])
 adapter.unbind();port.submit("move",{"tile":Vector2i.ZERO})
 assert(requests.size()==1)
 adapter.queue_free();port.queue_free();bus.queue_free();await process_frame
 print("ADAPTER PASS: command forwarding, state refresh, unavailable commands, disconnect")
 quit()
