# Servidor dedicado de GAIA para jugar en red por internet (también desde el navegador).
# Lleva la simulación sin dibujar nada; los cuatro jugadores se conectan por WebSocket. Los servicios como Render o Fly
# ponen el TLS (wss://) delante y dicen en la variable PORT en qué puerto escuchar. NO se ha probado en un servicio real:
# ver docs/MULTIJUGADOR.md (sección «Servidor dedicado»).
FROM debian:bookworm-slim
ARG GODOT=4.7.2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip libfontconfig1 libx11-6 \
	libxcursor1 libxinerama1 libxrandr2 libxi6 libgl1 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/godot.zip "https://github.com/godotengine/godot-builds/releases/download/${GODOT}-stable/Godot_v${GODOT}-stable_linux.x86_64.zip" \
	&& unzip -q /tmp/godot.zip -d /opt && mv "/opt/Godot_v${GODOT}-stable_linux.x86_64" /usr/local/bin/godot && rm /tmp/godot.zip
WORKDIR /app
COPY . .
RUN godot --headless --path . --import || true
ENV PORT=9080
EXPOSE 9080
CMD ["godot", "--headless", "--path", ".", "scenes/net/servidor.tscn", "--", "--servidor"]
