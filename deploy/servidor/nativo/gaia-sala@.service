# Una sala de GAIA por instancia: gaia-sala@9080, gaia-sala@9081... (el número es el puerto). Caddy las publica como
# wss://sala.<dominio>/1, /2, /3 y /4. Lo instala instalar_salas.sh.
[Unit]
Description=GAIA - sala multijugador en el puerto %i
After=network.target

[Service]
User=__USUARIO__
WorkingDirectory=/opt/gaia/repo
Environment=PORT=%i
ExecStart=/opt/gaia/godot --headless --path /opt/gaia/repo scenes/net/servidor.tscn -- --servidor
Restart=on-failure
RestartSec=3
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
